+++ b/scripts/automation/trex_control_plane/interactive/trex/stl/trex_stl_packet_builder_scapy.py
@@ -413,8 +413,38 @@
     def get_list_iter(self):
         l=list(self.pkt_iter())
         return l
+
+
+    def pkt_offset_iter(self):
+        """Yield packet layers with their offsets in the serialized packet."""
+        offset = 0
+        for pkt in self.pkt_iter():
+            yield pkt, offset
+            offset += len(pkt) - len(pkt.payload)

+    @staticmethod
+    def field_offset(layer_pkt, field_name):
+        """Return a field's byte offset and size within a serialized layer.

+        Scapy carries bit fields' parser state between fields as a
+        (bytes, bit cursor) tuple, so it is passed on unchanged.  As with the
+        `_offset` TRex's bundled Scapy records while building, a field's
+        offset counts the whole bytes before it, and a bit field's size is 0.
+        """
+        raw = bytes(layer_pkt)
+        state = raw
+        for field in layer_pkt.fields_desc:
+            remaining = state[0] if isinstance(state, tuple) else state
+            offset = len(raw) - len(remaining)
+            state, _ = field.getfield(layer_pkt, state)
+            if field.name == field_name:
+                if hasattr(field, 'size'):
+                    return offset, 0
+                consumed = state[0] if isinstance(state, tuple) else state
+                return offset, len(remaining) - len(consumed)
+        raise CTRexPacketBuildException(-11, "No field %s." % field_name)
+
+
